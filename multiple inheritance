package eswar;
 
class Multione {
	void one()
	{
		System.out.println("This is a Base Class");
		
	}

}
class MultiSecond extends Multione
{
	void second()
	{
		System.out.println("this is Intermediate Class"); 
		
	}
	
}
class MultiThird extends MultiSecond
{
	void Third()
	{
		System.out.println("This is a Derived class");
	}
}
public class multilevelinher {
	
	public static void main(String args []) {
		MultiThird obj=new MultiThird();
		obj.one();
		obj.second();
		obj.Third();
	}
}
